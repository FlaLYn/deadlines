# Copy to `.env`. Everything here is inlined into the build by electron-vite, so it
# applies to whatever you build next — there is nothing to configure at runtime.

# --- Google sign-in -----------------------------------------------------------------
# Set these to ship a build already wired to a Google OAuth client, so users never see
# the one-time setup screen. Without them, the app asks for the client ID on first launch.
#
# Create the credentials at https://console.cloud.google.com/apis/credentials
# using application type "Desktop app".
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
